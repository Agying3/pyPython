# pyPython 示例 —— 按 F5 运行
# 赋值用 「」，输出用 $()，没有分号，用缩进划分块

a「1」
b「a + 2」
$(a + b)

# 变量名可以用中文
中文「42」
$(中文)

# 比较：~ 是等于，· 是不等于
if a ~ 1
    $(42)
else
    $(0)

# 并排即相乘（只在括号内生效）
$( (1 + 2) 3 )

# 字符串，只能用双引号
greeting「"hello" + ", " + "world"」
$(greeting)

# 列表：可以嵌套，可以混类型
mixed「["a", "b", 1 + 2, [4, 5]]」
$(mixed)

# 「」 里可以跨行
跨行「1 +
2 +
3」
$(跨行)

# 试一试：把下面这行的 ~ 改成 ·，看输出怎么变
$(a ~ 1)

# ===== 第二版：循环、遍历、函数、类 =====

# 循环。第三版起支持 break / continue
i「0」
while i < 3
    $(i)
    i「i + 1」

# 遍历。只能遍历列表、字符串和字典，没有 range()
总计「0」
for v in [10, 20, 30]
    总计「总计 + v」
$(总计)

for c in "abc"
    $(c)

# 函数。参数没有默认值，return 可以省略（省略时返回 0）
def 加(a, b)
    return a + b
$(加(3, 4))

# 递归。能递归，但有深度上限（120 层）
def 阶乘(n)
    if n < 2
        return 1
    return n * 阶乘(n - 1)
$(阶乘(5))

# 类。构造器叫 __init__，self 不用写进参数表
class 点
    def __init__(x, y)
        self.x「x」
        self.y「y」
    def 长度平方()
        return self.x * self.x + self.y * self.y

p「点(3, 4)」
$(p.x)
$(p.长度平方())

# 作用域按 Python 来：函数里赋值默认建局部变量
g「1」
def 改全局()
    全局 g「999」
def 只改局部()
    g「777」

改全局()
$(g)

只改局部()
$(g)

# 注意：空行随便加，不影响块结构

# ===== 第三版：下标、字典、逻辑运算、循环控制 =====

# 下标：列表按位置取，-1 是最后一个
xs「[10, 20, 30]」
$(xs[0])
$(xs[-1])

# 下标也能赋值
xs[1]「99」
$(xs[1])

# 下标可以套下标
矩阵「[[1, 2], [3, 4]]」
$(矩阵[1][0])
矩阵[0][1]「55」
$(矩阵[0][1])

# 字典：key 要用 「」 包起来，冒号是本语言唯一的冒号用法
d「{}」
d「{「"name"」: "pyPython", 「"n"」: 3}」
$(d["name"])
$(d["n"])

# 往字典里加新项
d["extra"]「[1, 2]」
$(d["extra"][1])

# 遍历字典时变量拿到的是 key
for k in {「"a"」: 1, 「"b"」: 2}
    $(k)

# 逻辑运算用单词，不用 && || !
$(1 and 2)
$(0 or 5)
$(not 0)

# 短路：y 有值就不取默认值
y「0」
$(y or 100)

# 循环控制：break 跳出，continue 跳过
for v in [1, 2, 3, 4, 5]
    if v ~ 2
        continue
    if v > 4
        break
    $(v)

# 综合一下：找列表里的最大值（用下标）
数「[3, 9, 2, 7]」
最大「数[0]」
i「1」
while i < 4
    if 数[i] > 最大
        最大「数[i]」
    i「i + 1」
$(最大)


# --- 第四版：三值逻辑（真 / 假 / 未知）---------------------------------------
#
# 布尔有三个值，不是两个。第三态叫 未知，
# 它不是 None、不是错误、不是随机数，而是「还没被观测」。
# 它是本语言唯一一个别处没有的东西，写出来就是一个关键字。

x「未知」
$(x)

# 真值表（Kleene）：确定的一方能压过未知，不确定的一侧压不过去。
$(x and 1)     # 真 且 未知 = 未知
$(x and 0)     # 假 且 未知 = 假   ← 假能压过未知
$(1 or x)      # 真 或 未知 = 真   ← 真能压过未知
$(0 or x)      # 假 或 未知 = 未知
$(not x)       # 非 未知 = 未知    ← 取反不产生信息

# 未知会传染：它参与任何运算，结果都还是未知。
$(x + 1)
$(x > 1)
$((x + 1) > 0)

# 未知存进容器再取出来，仍然是未知。
盒子「[x]」
$(盒子[0])

# 先观测再判断：确真走 then，确假走 else。
y「1」
if y
    $("y 已观测，为真")
else
    $("y 已观测，为假")

# 没观测就不猜：if 碰到未知，两个分支都不执行，
# 不报错、不随机、不跳过，只往泬账本记一笔，让未知保持可见。
if x
    $("这一行不会执行")
else
    $("这一行也不会执行")

# while 同理：条件未知就不进循环体，记一笔账后退出。
计数「0」
while x
    $("这一行不会执行")
    计数「计数 + 1」
$(计数)

# 未知身上带着「污染标记」，跟着值一路走，
# 所以账本追得出它是从哪来的。下面四层传递后账本会画出完整链路。
y「x + 1」
z「y * 2」
w「z - 3」
if w
    $("这一行不会执行")
else
    $("这一行也不会执行")

# 两个**独立**的未知一起参与运算时，账本不会把它画成一条因果链，
# 而是画成两支（a 和 b 毫无关系，说「a 引起了 b」就是撒谎）。
a「未知」
b「未知」
c「a + b」
if c
    $("这一行不会执行")
else
    $("这一行也不会执行")

