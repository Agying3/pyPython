# pyPython 示例 —— 按 F5 运行
# 赋值用 「」，输出用 $()，没有分号，用缩进划分块

a「1」
b「a + 2」
$(a + b)

# 变量名可以用中文
中文「42」
$(中文)

# 比较：~ 是等于，· 是不等于
if a ~ 1
    $(42)
else
    $(0)

# 并排即相乘（只在括号内生效）
$( (1 + 2) 3 )

# 字符串，只能用双引号
greeting「"hello" + ", " + "world"」
$(greeting)

# 列表：可以嵌套，可以混类型
mixed「["a", "b", 1 + 2, [4, 5]]」
$(mixed)

# 「」 里可以跨行
跨行「1 +
2 +
3」
$(跨行)

# 试一试：把下面这行的 ~ 改成 ·，看输出怎么变
$(a ~ 1)

# ===== 第二版：循环、遍历、函数、类 =====

# 循环。没有 break / continue，想跳出只能让条件变假
i「0」
while i < 3
    $(i)
    i「i + 1」

# 遍历。只能遍历列表和字符串，没有 range()
总计「0」
for v in [10, 20, 30]
    总计「总计 + v」
$(总计)

for c in "abc"
    $(c)

# 函数。参数没有默认值，return 可以省略（省略时返回 0）
def 加(a, b)
    return a + b
$(加(3, 4))

# 递归。能递归，但有深度上限（120 层）
def 阶乘(n)
    if n < 2
        return 1
    return n * 阶乘(n - 1)
$(阶乘(5))

# 类。构造器叫 __init__，self 不用写进参数表
class 点
    def __init__(x, y)
        self.x「x」
        self.y「y」
    def 长度平方()
        return self.x * self.x + self.y * self.y

p「点(3, 4)」
$(p.x)
$(p.长度平方())

# 作用域按 Python 来：函数里赋值默认建局部变量
g「1」
def 改全局()
    全局 g「999」
def 只改局部()
    g「777」

改全局()
$(g)

只改局部()
$(g)

# 注意：空行随便加，不影响块结构

