# pyPython 示例 —— 按 F5 运行
# 赋值用 「」，输出用 $()，没有分号，用缩进划分块

a「1」
b「a + 2」
$(a + b)

# 变量名可以用中文
中文「42」
$(中文)

# 比较：~ 是等于，· 是不等于
if a ~ 1
    $(42)
else
    $(0)

# 并排即相乘（只在括号内生效）
$( (1 + 2) 3 )

# 字符串，只能用双引号
greeting「"hello" + ", " + "world"」
$(greeting)

# 列表：可以嵌套，可以混类型
mixed「["a", "b", 1 + 2, [4, 5]]」
$(mixed)

# 「」 里可以跨行
跨行「1 +
2 +
3」
$(跨行)

# 试一试：把下面这行的 ~ 改成 ·，看输出怎么变
$(a ~ 1)

# ===== 第二版：循环、遍历、函数、类 =====

# 循环。第三版起支持 break / continue
i「0」
while i < 3
    $(i)
    i「i + 1」

# 遍历。只能遍历列表、字符串和字典，没有 range()
总计「0」
for v in [10, 20, 30]
    总计「总计 + v」
$(总计)

for c in "abc"
    $(c)

# 函数。参数没有默认值，return 可以省略（省略时返回 0）
def 加(a, b)
    return a + b
$(加(3, 4))

# 递归。能递归，但有深度上限（120 层）
def 阶乘(n)
    if n < 2
        return 1
    return n * 阶乘(n - 1)
$(阶乘(5))

# 类。构造器叫 __init__，self 不用写进参数表
class 点
    def __init__(x, y)
        self.x「x」
        self.y「y」
    def 长度平方()
        return self.x * self.x + self.y * self.y

p「点(3, 4)」
$(p.x)
$(p.长度平方())

# 作用域按 Python 来：函数里赋值默认建局部变量
g「1」
def 改全局()
    全局 g「999」
def 只改局部()
    g「777」

改全局()
$(g)

只改局部()
$(g)

# 注意：空行随便加，不影响块结构

# ===== 第三版：下标、字典、逻辑运算、循环控制 =====

# 下标：列表按位置取，-1 是最后一个
xs「[10, 20, 30]」
$(xs[0])
$(xs[-1])

# 下标也能赋值
xs[1]「99」
$(xs[1])

# 下标可以套下标
矩阵「[[1, 2], [3, 4]]」
$(矩阵[1][0])
矩阵[0][1]「55」
$(矩阵[0][1])

# 字典：key 要用 「」 包起来，冒号是本语言唯一的冒号用法
d「{}」
d「{「"name"」: "pyPython", 「"n"」: 3}」
$(d["name"])
$(d["n"])

# 往字典里加新项
d["extra"]「[1, 2]」
$(d["extra"][1])

# 遍历字典时变量拿到的是 key
for k in {「"a"」: 1, 「"b"」: 2}
    $(k)

# 逻辑运算用单词，不用 && || !
$(1 and 2)
$(0 or 5)
$(not 0)

# 短路：y 有值就不取默认值
y「0」
$(y or 100)

# 循环控制：break 跳出，continue 跳过
for v in [1, 2, 3, 4, 5]
    if v ~ 2
        continue
    if v > 4
        break
    $(v)

# 综合一下：找列表里的最大值（用下标）
数「[3, 9, 2, 7]」
最大「数[0]」
i「1」
while i < 4
    if 数[i] > 最大
        最大「数[i]」
    i「i + 1」
$(最大)

