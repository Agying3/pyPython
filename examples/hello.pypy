# pyPython 示例 —— 按 F5 运行
# 赋值用 「」，输出用 $()，没有分号，用缩进划分块

a「1」
b「a + 2」
$(a + b)

# 比较：~ 是等于，· 是不等于
if a ~ 1
    $(42)
else
    $(0)

# 并排即相乘（只在括号内生效）
$( (1 + 2) 3 )

# 字符串，只能用双引号
greeting「"hello" + ", " + "world"」
$(greeting)

# 列表：可以嵌套，可以混类型
mixed「["a", "b", 1 + 2, [4, 5]]」
$(mixed)

# 试一试：把下面这行的 ~ 改成 ·，看输出怎么变
$(a ~ 1)
